default_platform(:ios)

PROJECT = "Yosuf.xcodeproj"
SCHEME = "Yosuf"
BUNDLE_ID = "com.yosufgame.app"
KEYCHAIN_NAME = "yosuf-ci.keychain-db"
PROFILE_NAME = "Yosuf App Store Profile" # must match the profile's name in Apple Developer exactly

platform :ios do
  desc "Build and upload a release build to TestFlight"
  lane :release_to_testflight do
    setup_ci_keychain
    import_signing_identity
    install_provisioning_profile_from_secret
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    increment_build_number_in_plist

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "build",
      output_name: "Yosuf.ipa",
      export_options: {
        provisioningProfiles: {
          BUNDLE_ID => PROFILE_NAME
        },
        signingStyle: "manual"
      },
      xcargs: "CODE_SIGN_IDENTITY=\"Apple Distribution\" DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "build/Yosuf.ipa"
    )
  end

  private_lane :setup_ci_keychain do
    create_keychain(
      name: KEYCHAIN_NAME,
      password: ENV["KEYCHAIN_PASSWORD"],
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )
  end

  private_lane :import_signing_identity do
    p12_path = "signing_certificate.p12"
    File.write(p12_path, Base64.decode64(ENV["IOS_DISTRIBUTION_CERTIFICATE_P12"]))
    import_certificate(
      certificate_path: p12_path,
      certificate_password: ENV["IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"],
      keychain_name: KEYCHAIN_NAME,
      keychain_password: ENV["KEYCHAIN_PASSWORD"]
    )
    File.delete(p12_path)
  end

  private_lane :install_provisioning_profile_from_secret do
    profile_path = "profile.mobileprovision"
    File.write(profile_path, Base64.decode64(ENV["IOS_PROVISIONING_PROFILE_BASE64"]))
    UI.message("Installing provisioning profile...")
    profiles_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(profiles_dir)
    uuid = sh("grep -aA1 UUID #{profile_path} | grep -io \"[-A-F0-9]\\{36\\}\"").strip
    FileUtils.cp(profile_path, File.join(profiles_dir, "#{uuid}.mobileprovision"))
    File.delete(profile_path)
  end

  private_lane :increment_build_number_in_plist do
    increment_build_number(
      xcodeproj: PROJECT,
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s
    )
  end
end
